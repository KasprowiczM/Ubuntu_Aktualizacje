#!/usr/bin/env bash
# Post-install: leave the heavy bring-up (Python venv, dashboard service,
# Proton overlay restore) to the operator's first interactive run of
# `ubuntu-aktualizacje fresh`. We only fix permissions and print a hint.
set -e

INSTALL_DIR=/opt/ascendo-ubuntu
chmod -R u+rwX,go+rX "$INSTALL_DIR" 2>/dev/null || true
chmod +x "$INSTALL_DIR"/update-all.sh \
         "$INSTALL_DIR"/scripts/*.sh \
         "$INSTALL_DIR"/scripts/*/*.sh 2>/dev/null || true

# /usr/bin/ascendo-ubuntu shim is already installed by dpkg from the
# package tree.

# Refresh icon + desktop databases so the Ascendo entry shows in app menus.
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

cat <<EOF
─────────────────────────────────────────────────────────────────
  Ascendo Ubuntu installed at $INSTALL_DIR

  Next steps (run as your normal user, NOT root):
    ascendo-ubuntu fresh           # full bring-up incl. dashboard
    ascendo-ubuntu                 # alias for update-all.sh
    ascendo-ubuntu dashboard       # start dashboard ad-hoc

  Dashboard URL after install: http://127.0.0.1:8766
─────────────────────────────────────────────────────────────────
EOF
exit 0
