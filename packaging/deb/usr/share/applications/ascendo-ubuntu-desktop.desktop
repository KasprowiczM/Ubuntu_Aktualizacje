[Desktop Entry]
Type=Application
Name=Ascendo - Unified Updates (Desktop)
GenericName=System Update Manager
Comment=Standalone Ascendo desktop window (no browser tab)
Exec=ascendo-ubuntu-launch desktop
Icon=ascendo-ubuntu
Terminal=false
Categories=System;Settings;PackageManager;
Keywords=update;apt;snap;flatpak;brew;npm;ascendo;
StartupNotify=true
StartupWMClass=AscendoUbuntuDesktop
